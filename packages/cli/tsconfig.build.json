{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@specter/types": ["packages/types/dist/index.d.ts"],
      "@specter/core": ["packages/core/dist/index.d.ts"],
      "@specter/config": ["packages/config/dist/index.d.ts"],
      "@specter/scanner-static": ["packages/scanner-static/dist/index.d.ts"],
      "@specter/scanner-secrets": ["packages/scanner-secrets/dist/index.d.ts"],
      "@specter/scanner-dependencies": ["packages/scanner-dependencies/dist/index.d.ts"],
      "@specter/risk-engine": ["packages/risk-engine/dist/index.d.ts"],
      "@specter/reporter": ["packages/reporter/dist/index.d.ts"],
      "@specter/scanner-build": ["packages/scanner-build/dist/index.d.ts"],
      "@specter/scanner-web": ["packages/scanner-web/dist/index.d.ts"]
    },
    "sourceMap": false,
    "declarationMap": false,
    "incremental": false
  },
  "include": ["src/**/*.ts", "../../types/node-ambient.d.ts", "../../types/playwright-ambient.d.ts"]
}
