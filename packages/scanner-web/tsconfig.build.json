{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@specter/types": [
        "packages/types/dist/index.d.ts"
      ],
      "@specter/core": [
        "packages/core/dist/index.d.ts"
      ]
    },
    "sourceMap": false,
    "declarationMap": false,
    "incremental": false
  },
  "include": [
    "src/**/*.ts",
    "../../types/node-ambient.d.ts",
    "../../types/playwright-ambient.d.ts"
  ]
}
