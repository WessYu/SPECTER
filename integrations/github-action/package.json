{
  "name": "@specter-security/github-action",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@specter-security/cli": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests"
  }
}
