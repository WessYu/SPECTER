generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  owner
  admin
  member
  viewer
}

enum ScanStatus {
  queued
  running
  completed
  failed
  cancelled
}

model User {
  id             String               @id @default(cuid())
  githubId       String?              @unique
  email          String?              @unique
  name           String?
  avatarUrl      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  memberships    OrganizationMember[]
  sessions       Session[]
}

model Organization {
  id             String               @id @default(cuid())
  name           String
  slug           String               @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  members        OrganizationMember[]
  projects       Project[]
  apiKeys        ApiKey[]
  sessions       Session[]
}

model OrganizationMember {
  id             String               @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole
  createdAt      DateTime             @default(now())
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([organizationId, userId])
  @@index([userId])
}


model Session {
  id             String               @id @default(cuid())
  tokenHash      String               @unique
  userId         String
  organizationId String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime             @default(now())
  lastUsedAt     DateTime             @default(now())
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt, expiresAt])
  @@index([organizationId, revokedAt])
}

model Project {
  id             String               @id @default(cuid())
  organizationId String
  name           String
  slug           String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domains        Domain[]
  scans          Scan[]
  findings       Finding[]
  suppressions   Suppression[]
  externalDomains ExternalDomain[]
  routes         Route[]
  deployments    Deployment[]
  integrations   Integration[]
  activeTargets  ActiveTarget[]
  activeScans    ActiveScan[]
  activeAuditLogs ActiveAuditLog[]
  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Domain {
  id             String               @id @default(cuid())
  projectId      String
  hostname       String
  verifiedAt     DateTime?
  createdAt      DateTime             @default(now())
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  verifications  DomainVerification[]
  @@unique([projectId, hostname])
  @@index([projectId])
}

model DomainVerification {
  id             String               @id @default(cuid())
  domainId       String
  tokenHash      String
  tokenPrefix    String
  method         String
  expiresAt      DateTime
  verifiedAt     DateTime?
  createdAt      DateTime             @default(now())
  domain         Domain               @relation(fields: [domainId], references: [id], onDelete: Cascade)
  @@index([domainId, expiresAt])
}

model Scan {
  id             String               @id
  projectId      String
  targetKind     String
  targetValue    String
  status         ScanStatus
  score          Float
  schemaVersion  String
  summaryJson    Json
  modulesJson    Json
  errorsJson     Json
  surfaceJson    Json?
  startedAt      DateTime
  completedAt    DateTime
  durationMs     Int
  scanType       String?
  authorizationJson Json?
  profile        String?
  budgetJson     Json?
  endpointCount  Int?
  confirmedCount Int?
  potentialCount Int?
  regressionDelta Float?
  createdAt      DateTime             @default(now())
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  occurrences    FindingOccurrence[]
  externalDomains ExternalDomain[]
  routes         Route[]
  activeExecution ActiveScan?
  @@index([projectId, completedAt(sort: Desc)])
  @@index([projectId, score])
}

model Finding {
  id             String               @id @default(cuid())
  projectId      String
  fingerprint    String
  ruleId         String
  title          String
  description    String
  severity       String
  category       String
  confidence     String
  source         String
  scanner        String?
  phase          String?
  validationStatus String?
  method         String?
  route          String?
  parameter      String?
  reproduction   String?
  whyItMatters   String?
  remediation    String?
  documentationUrl String?
  firstDetectedAt DateTime
  lastDetectedAt DateTime
  status         String               @default("open")
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  occurrences    FindingOccurrence[]
  @@unique([projectId, fingerprint])
  @@index([projectId, severity, status])
  @@index([ruleId])
}

model FindingOccurrence {
  id             String               @id @default(cuid())
  findingId      String
  scanId         String
  file           String?
  line           Int?
  column         Int?
  url            String?
  evidenceJson   Json?
  severity       String
  observedAt     DateTime
  finding        Finding              @relation(fields: [findingId], references: [id], onDelete: Cascade)
  scan           Scan                 @relation(fields: [scanId], references: [id], onDelete: Cascade)
  @@unique([findingId, scanId])
  @@index([scanId])
}

model Suppression {
  id             String               @id @default(cuid())
  projectId      String
  ruleId         String?
  fingerprint    String?
  reason         String
  expiresAt      DateTime?
  createdBy      String
  createdAt      DateTime             @default(now())
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, expiresAt])
}

model ExternalDomain {
  id             String               @id @default(cuid())
  projectId      String
  scanId         String?
  domain         String
  classification String
  resourceTypes  String[]
  firstSeenAt    DateTime             @default(now())
  lastSeenAt     DateTime             @default(now())
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scan           Scan?                @relation(fields: [scanId], references: [id], onDelete: SetNull)
  @@unique([projectId, domain])
  @@index([scanId])
}

model Route {
  id             String               @id @default(cuid())
  projectId      String
  scanId         String?
  method         String
  url            String
  status         Int?
  contentType    String?
  cors           String?
  authObservable Boolean?
  firstSeenAt    DateTime             @default(now())
  lastSeenAt     DateTime             @default(now())
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scan           Scan?                @relation(fields: [scanId], references: [id], onDelete: SetNull)
  @@unique([projectId, method, url])
  @@index([scanId])
}

model Deployment {
  id             String               @id @default(cuid())
  projectId      String
  environment    String
  url            String
  commitSha      String?
  createdAt      DateTime             @default(now())
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, createdAt(sort: Desc)])
}

model Integration {
  id             String               @id @default(cuid())
  projectId      String
  type           String
  configJson     Json
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId])
}

model ActiveTarget {
  id                     String           @id @default(cuid())
  projectId              String
  url                    String
  hostname               String
  authorizationStatus    String           @default("unverified")
  tokenHash              String?
  tokenPrefix            String?
  verificationExpiresAt  DateTime?
  verifiedAt             DateTime?
  authorizationExpiresAt DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  project                Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scans                   ActiveScan[]
  auditLogs               ActiveAuditLog[]
  @@unique([projectId, url])
  @@index([projectId, authorizationStatus])
  @@index([hostname])
}

model ActiveScan {
  id             String          @id @default(cuid())
  projectId      String
  targetId       String
  status         ScanStatus      @default(queued)
  profile        String
  requestBudget  Int
  requestCount   Int             @default(0)
  endpointCount  Int             @default(0)
  findingCount   Int             @default(0)
  confirmedCount Int             @default(0)
  score          Float?
  resultScanId   String?         @unique
  startedAt      DateTime?
  completedAt    DateTime?
  error          String?
  createdBy      String
  createdAt      DateTime        @default(now())
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  target         ActiveTarget    @relation(fields: [targetId], references: [id], onDelete: Cascade)
  resultScan     Scan?           @relation(fields: [resultScanId], references: [id], onDelete: SetNull)
  auditLogs      ActiveAuditLog[]
  @@index([projectId, createdAt(sort: Desc)])
  @@index([targetId, createdAt(sort: Desc)])
  @@index([projectId, status])
}

model ActiveAuditLog {
  id           String        @id @default(cuid())
  projectId    String
  targetId     String?
  activeScanId String?
  principalId  String
  action       String
  metadataJson Json?
  createdAt    DateTime      @default(now())
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  target       ActiveTarget? @relation(fields: [targetId], references: [id], onDelete: SetNull)
  activeScan   ActiveScan?   @relation(fields: [activeScanId], references: [id], onDelete: SetNull)
  @@index([projectId, createdAt(sort: Desc)])
  @@index([activeScanId])
}

model ApiKey {
  id             String               @id @default(cuid())
  organizationId String
  name           String
  prefix         String               @unique
  keyHash        String
  createdBy      String
  createdAt      DateTime             @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, revokedAt])
}
